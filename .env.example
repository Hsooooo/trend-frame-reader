# Comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Bearer token used for /admin/* endpoints
ADMIN_TOKEN=replace-with-long-random-string

# DeepL translation (title only)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_TIMEOUT_SECONDS=6.0
DEEPL_RETRIES=1

# OpenAI / market graph
OPENAI_API_KEY=
OPENAI_KEYWORD_MODEL=gpt-4o-mini
OPENAI_KEYWORD_FALLBACK_MODEL=gpt-5-mini
OPENAI_MARKET_ENTITY_MODEL=gpt-4o-mini
OPENAI_MARKET_ENTITY_FALLBACK_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=trend_frame_graph
